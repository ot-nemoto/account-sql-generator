{
  "name": "account-sql-generator",
  "version": "0.4.18",
  "private": true,
  "scripts": {
    "prepare": "biome migrate --write",
    "dev": "next dev",
    "build": "next build",
    "build:static": "cross-env BUILD_MODE=static next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@vitest/coverage-v8": "^4",
    "vitest": "^4",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4",
    "typescript": "^6"
  }
}
